{
  "components": {
    "parameters": {
      "CsrfToken": {
        "in": "header",
        "name": "X-CSRF-Token",
        "required": true,
        "schema": {
          "minLength": 1,
          "type": "string"
        }
      },
      "IfMatch": {
        "in": "header",
        "name": "If-Match",
        "required": true,
        "schema": {
          "pattern": "^\\\"rev-[1-9][0-9]*\\\"$",
          "type": "string"
        }
      },
      "NoteId": {
        "in": "path",
        "name": "note_id",
        "required": true,
        "schema": {
          "format": "uuid",
          "pattern": "^[0-9a-fA-F-]{36}$",
          "type": "string"
        }
      }
    },
    "responses": {
      "AuthenticationRequired": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "OIDC session is required"
      },
      "BadRequest": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "the request syntax or If-Match value is invalid"
      },
      "Conflict": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "the If-Match revision is stale"
      },
      "CsrfRejected": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "same-origin or CSRF validation failed"
      },
      "NotFound": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "note or authorization is not visible"
      },
      "PreconditionRequired": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "If-Match is required"
      },
      "UnprocessableNote": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "the note input is invalid or cannot be rendered safely"
      },
      "ValidationFailed": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "note input is invalid"
      }
    },
    "schemas": {
      "Health": {
        "additionalProperties": false,
        "properties": {
          "api_version": {
            "const": "v3"
          },
          "status": {
            "const": "ok"
          }
        },
        "required": [
          "status",
          "api_version"
        ],
        "type": "object"
      },
      "Note": {
        "additionalProperties": false,
        "properties": {
          "created_at_ms": {
            "type": "integer"
          },
          "note_id": {
            "format": "uuid",
            "pattern": "^[0-9a-fA-F-]{36}$",
            "type": "string"
          },
          "revision": {
            "minimum": 1,
            "type": "integer"
          },
          "source": {
            "type": "string"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": {
            "type": "string"
          },
          "updated_at_ms": {
            "type": "integer"
          }
        },
        "required": [
          "note_id",
          "title",
          "source",
          "tags",
          "created_at_ms",
          "updated_at_ms",
          "revision"
        ],
        "type": "object"
      },
      "NoteAcl": {
        "additionalProperties": false,
        "properties": {
          "entries": {
            "items": {
              "$ref": "#/components/schemas/NoteAclGrant"
            },
            "type": "array"
          }
        },
        "required": [
          "entries"
        ],
        "type": "object"
      },
      "NoteAclEntry": {
        "additionalProperties": false,
        "properties": {
          "permission": {
            "enum": [
              "read",
              "edit"
            ]
          },
          "subject": {
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "subject",
          "permission"
        ],
        "type": "object"
      },
      "NoteAclGrant": {
        "additionalProperties": false,
        "properties": {
          "issuer": {
            "format": "uri",
            "maxLength": 2048,
            "type": "string"
          },
          "permission": {
            "enum": [
              "read",
              "edit"
            ]
          },
          "subject": {
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "issuer",
          "subject",
          "permission"
        ],
        "type": "object"
      },
      "NoteAclUpdate": {
        "additionalProperties": false,
        "properties": {
          "entries": {
            "items": {
              "$ref": "#/components/schemas/NoteAclEntry"
            },
            "type": "array"
          }
        },
        "required": [
          "entries"
        ],
        "type": "object"
      },
      "NoteDiagnostic": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "error",
              "warning",
              "information",
              "hint"
            ]
          },
          "span": {
            "additionalProperties": false,
            "properties": {
              "end": {
                "minimum": 0,
                "type": "integer"
              },
              "start": {
                "minimum": 0,
                "type": "integer"
              },
              "unit": {
                "const": "utf8_byte"
              }
            },
            "required": [
              "start",
              "end",
              "unit"
            ],
            "type": "object"
          },
          "target": {
            "oneOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "field": {
                    "enum": [
                      "source",
                      "title",
                      "body",
                      "tags"
                    ]
                  }
                },
                "required": [
                  "field"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "field": {
                    "enum": [
                      "tag",
                      "acl_entry"
                    ]
                  },
                  "index": {
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "field",
                  "index"
                ],
                "type": "object"
              }
            ]
          }
        },
        "required": [
          "code",
          "severity",
          "target",
          "message"
        ],
        "type": "object"
      },
      "NoteDraft": {
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string",
            "x-maxBytes": 524288
          }
        },
        "required": [
          "source"
        ],
        "type": "object"
      },
      "NoteListEntry": {
        "additionalProperties": false,
        "properties": {
          "access": {
            "enum": [
              "read",
              "edit",
              "manage"
            ]
          },
          "note_id": {
            "format": "uuid",
            "pattern": "^[0-9a-fA-F-]{36}$",
            "type": "string"
          },
          "revision": {
            "minimum": 1,
            "type": "integer"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": {
            "type": "string"
          },
          "updated_at_ms": {
            "type": "integer"
          }
        },
        "required": [
          "note_id",
          "title",
          "tags",
          "updated_at_ms",
          "revision",
          "access"
        ],
        "type": "object"
      },
      "NotePreview": {
        "additionalProperties": false,
        "properties": {
          "diagnostics": {
            "items": {
              "$ref": "#/components/schemas/NoteDiagnostic"
            },
            "type": "array"
          },
          "html": {
            "type": "string"
          }
        },
        "required": [
          "html",
          "diagnostics"
        ],
        "type": "object"
      },
      "NoteSummary": {
        "additionalProperties": false,
        "properties": {
          "note_id": {
            "format": "uuid",
            "pattern": "^[0-9a-fA-F-]{36}$",
            "type": "string"
          },
          "revision": {
            "minimum": 1,
            "type": "integer"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": {
            "type": "string"
          },
          "updated_at_ms": {
            "type": "integer"
          }
        },
        "required": [
          "note_id",
          "title",
          "tags",
          "updated_at_ms",
          "revision"
        ],
        "type": "object"
      },
      "NoteView": {
        "additionalProperties": false,
        "properties": {
          "access": {
            "enum": [
              "read",
              "edit",
              "manage"
            ]
          },
          "html": {
            "type": "string"
          },
          "note": {
            "$ref": "#/components/schemas/Note"
          },
          "related": {
            "additionalProperties": false,
            "properties": {
              "incoming": {
                "items": {
                  "$ref": "#/components/schemas/NoteSummary"
                },
                "type": "array"
              },
              "outgoing": {
                "items": {
                  "$ref": "#/components/schemas/NoteSummary"
                },
                "type": "array"
              }
            },
            "required": [
              "outgoing",
              "incoming"
            ],
            "type": "object"
          }
        },
        "required": [
          "note",
          "access",
          "html",
          "related"
        ],
        "type": "object"
      },
      "Problem": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "authentication_required",
              "authentication_unavailable",
              "csrf_rejected",
              "csrf_required",
              "csrf_invalid",
              "same_origin_required",
              "origin_not_allowed",
              "not_found",
              "forbidden",
              "conflict",
              "precondition_required",
              "invalid_request",
              "validation_failed",
              "render_failed",
              "unavailable"
            ]
          },
          "diagnostics": {
            "items": {
              "$ref": "#/components/schemas/NoteDiagnostic"
            },
            "type": "array"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "Session": {
        "additionalProperties": false,
        "properties": {
          "issuer": {
            "format": "uri",
            "type": "string"
          },
          "subject": {
            "type": "string"
          }
        },
        "required": [
          "issuer",
          "subject"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Marginalis REST API",
    "version": "v3",
    "x-adocweave-package-version": "0.17.0",
    "x-note-profile-version": 5
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v3/health": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "service is running"
          }
        },
        "summary": "Liveness check"
      }
    },
    "/api/v3/notes": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/NoteListEntry"
                  },
                  "type": "array"
                }
              }
            },
            "description": "visible note summaries"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          }
        },
        "summary": "List visible note summaries"
      },
      "post": {
        "parameters": [
          {
            "$ref": "#/components/parameters/CsrfToken"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NoteDraft"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Note"
                }
              }
            },
            "description": "created note",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/CsrfRejected"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableNote"
          }
        },
        "summary": "Create a note"
      }
    },
    "/api/v3/notes/preview": {
      "post": {
        "parameters": [
          {
            "$ref": "#/components/parameters/CsrfToken"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NoteDraft"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotePreview"
                }
              }
            },
            "description": "safe HTML preview"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/CsrfRejected"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableNote"
          }
        },
        "summary": "Validate and render an unsaved note"
      }
    },
    "/api/v3/notes/{note_id}": {
      "delete": {
        "parameters": [
          {
            "$ref": "#/components/parameters/CsrfToken"
          },
          {
            "$ref": "#/components/parameters/IfMatch"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Note"
                }
              }
            },
            "description": "soft-deleted note",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableNote"
          },
          "428": {
            "$ref": "#/components/responses/PreconditionRequired"
          }
        },
        "summary": "Soft-delete a note"
      },
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Note"
                }
              }
            },
            "description": "note",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "summary": "Read one visible note"
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/NoteId"
        }
      ],
      "put": {
        "parameters": [
          {
            "$ref": "#/components/parameters/CsrfToken"
          },
          {
            "$ref": "#/components/parameters/IfMatch"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NoteDraft"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Note"
                }
              }
            },
            "description": "updated note",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableNote"
          },
          "428": {
            "$ref": "#/components/responses/PreconditionRequired"
          }
        },
        "summary": "Update a note"
      }
    },
    "/api/v3/notes/{note_id}/acl": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoteAcl"
                }
              }
            },
            "description": "ACL entries",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "summary": "Read note ACL"
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/NoteId"
        }
      ],
      "put": {
        "parameters": [
          {
            "$ref": "#/components/parameters/CsrfToken"
          },
          {
            "$ref": "#/components/parameters/IfMatch"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NoteAclUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Note"
                }
              }
            },
            "description": "note with updated ACL",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableNote"
          },
          "428": {
            "$ref": "#/components/responses/PreconditionRequired"
          }
        },
        "summary": "Replace note ACL"
      }
    },
    "/api/v3/notes/{note_id}/restore": {
      "parameters": [
        {
          "$ref": "#/components/parameters/NoteId"
        }
      ],
      "post": {
        "parameters": [
          {
            "$ref": "#/components/parameters/CsrfToken"
          },
          {
            "$ref": "#/components/parameters/IfMatch"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Note"
                }
              }
            },
            "description": "restored note",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableNote"
          },
          "428": {
            "$ref": "#/components/responses/PreconditionRequired"
          }
        },
        "summary": "Restore a note"
      }
    },
    "/api/v3/notes/{note_id}/source": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "text/asciidoc": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "AsciiDoc source"
          }
        },
        "summary": "Export canonical AsciiDoc"
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/NoteId"
        }
      ]
    },
    "/api/v3/notes/{note_id}/view": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoteView"
                }
              }
            },
            "description": "rendered note view",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/ValidationFailed"
          }
        },
        "summary": "Read one coherent note view"
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/NoteId"
        }
      ]
    },
    "/api/v3/session": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            },
            "description": "authenticated session"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          }
        },
        "summary": "Read the current identity"
      }
    }
  }
}
