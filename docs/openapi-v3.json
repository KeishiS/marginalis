{
  "openapi": "3.1.0",
  "info": { "title": "Marginalis API", "version": "v2" },
  "paths": {
    "/api/v2/health": { "get": { "responses": { "200": { "description": "ready" } } } },
    "/api/v2/session": { "get": { "responses": { "200": { "description": "Kanidm subject" }, "401": { "description": "authentication required" } } } },
    "/api/v2/notes": {
      "get": { "responses": { "200": { "description": "visible notes" }, "401": { "description": "authentication required" } } },
      "post": { "requestBody": { "required": true }, "responses": { "201": { "description": "created" }, "403": { "description": "CSRF rejected" } } }
    },
    "/api/v2/notes/{note_id}": {
      "get": { "responses": { "200": { "description": "note" }, "404": { "description": "not visible" } } },
      "put": { "responses": { "200": { "description": "updated" }, "409": { "description": "revision conflict" } } },
      "delete": { "responses": { "200": { "description": "soft deleted" }, "409": { "description": "revision conflict" } } }
    },
    "/api/v2/notes/{note_id}/source": { "get": { "responses": { "200": { "description": "AsciiDoc export" } } } }
  }
}
