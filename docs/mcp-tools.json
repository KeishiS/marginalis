[
  {
    "name": "list_notes",
    "description": "List visible note summaries",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "title": "McpEmptyInput",
      "type": "object"
    },
    "outputSchema": {
      "$defs": {
        "McpNoteSummary": {
          "additionalProperties": false,
          "properties": {
            "note_id": {
              "type": "string"
            },
            "revision": {
              "format": "int64",
              "minimum": 1,
              "type": "integer"
            },
            "tags": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "title": {
              "type": "string"
            },
            "updated_at_ms": {
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "note_id",
            "title",
            "tags",
            "updated_at_ms",
            "revision"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "notes": {
          "items": {
            "$ref": "#/$defs/McpNoteSummary"
          },
          "type": "array"
        }
      },
      "required": [
        "notes"
      ],
      "title": "McpListNotesOutput",
      "type": "object"
    }
  },
  {
    "name": "get_note_profile",
    "description": "Read the current note profile",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "title": "McpEmptyInput",
      "type": "object"
    },
    "outputSchema": {
      "$defs": {
        "McpNoteProfileExample": {
          "additionalProperties": false,
          "properties": {
            "body": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "kind": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "description",
            "body"
          ],
          "type": "object"
        },
        "McpNoteProfileLimits": {
          "additionalProperties": false,
          "properties": {
            "applies_after_normalization": {
              "type": "boolean"
            },
            "max_source_bytes": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "max_tag_characters": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "max_tags": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "max_title_characters": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "applies_after_normalization",
            "max_title_characters",
            "max_source_bytes",
            "max_tags",
            "max_tag_characters"
          ],
          "type": "object"
        },
        "McpNoteProfileNormalization": {
          "additionalProperties": false,
          "properties": {
            "tags": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "title": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "title",
            "tags"
          ],
          "type": "object"
        },
        "McpNoteProfileRule": {
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string"
            },
            "description": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "description"
          ],
          "type": "object"
        },
        "McpNoteProfileSyntax": {
          "additionalProperties": false,
          "properties": {
            "allowed_math_languages": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "common_blocks": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "common_inlines": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "source_language_optional": {
              "type": "boolean"
            },
            "tag_forbidden": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "title_forbidden": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "common_blocks",
            "common_inlines",
            "source_language_optional",
            "allowed_math_languages",
            "title_forbidden",
            "tag_forbidden"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "adocweave_package_version": {
          "type": "string"
        },
        "allowed_source_languages": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "authoring_guidance": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "examples": {
          "items": {
            "$ref": "#/$defs/McpNoteProfileExample"
          },
          "type": "array"
        },
        "forbidden_rules": {
          "items": {
            "$ref": "#/$defs/McpNoteProfileRule"
          },
          "type": "array"
        },
        "limits": {
          "$ref": "#/$defs/McpNoteProfileLimits"
        },
        "normalization": {
          "$ref": "#/$defs/McpNoteProfileNormalization"
        },
        "profile_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "syntax": {
          "$ref": "#/$defs/McpNoteProfileSyntax"
        }
      },
      "required": [
        "profile_version",
        "adocweave_package_version",
        "limits",
        "normalization",
        "syntax",
        "authoring_guidance",
        "allowed_source_languages",
        "forbidden_rules",
        "examples"
      ],
      "title": "McpNoteProfileOutput",
      "type": "object"
    }
  },
  {
    "name": "get_note",
    "description": "Read one visible note",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "note_id": {
          "pattern": "^[0-9a-fA-F-]{36}$",
          "type": "string"
        }
      },
      "required": [
        "note_id"
      ],
      "title": "McpGetNoteInput",
      "type": "object"
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "note_id": {
          "type": "string"
        },
        "revision": {
          "format": "int64",
          "minimum": 1,
          "type": "integer"
        },
        "source": {
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "title": {
          "type": "string"
        },
        "updated_at_ms": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "note_id",
        "title",
        "source",
        "tags",
        "updated_at_ms",
        "revision"
      ],
      "title": "McpGetNoteOutput",
      "type": "object"
    }
  },
  {
    "name": "create_note",
    "description": "Create a note",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "source": {
          "maxLength": 524288,
          "type": "string"
        }
      },
      "required": [
        "source"
      ],
      "title": "McpCreateNoteInput",
      "type": "object"
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "note_id": {
          "type": "string"
        },
        "revision": {
          "format": "int64",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "note_id",
        "revision"
      ],
      "title": "McpNoteRevisionOutput",
      "type": "object"
    }
  },
  {
    "name": "update_note",
    "description": "Update a note at the expected revision",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "expected_revision": {
          "format": "int64",
          "minimum": 1,
          "type": "integer"
        },
        "note_id": {
          "pattern": "^[0-9a-fA-F-]{36}$",
          "type": "string"
        },
        "source": {
          "maxLength": 524288,
          "type": "string"
        }
      },
      "required": [
        "note_id",
        "source",
        "expected_revision"
      ],
      "title": "McpUpdateNoteInput",
      "type": "object"
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "note_id": {
          "type": "string"
        },
        "revision": {
          "format": "int64",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "note_id",
        "revision"
      ],
      "title": "McpNoteRevisionOutput",
      "type": "object"
    }
  },
  {
    "name": "delete_note",
    "description": "Soft-delete a note at the expected revision",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "expected_revision": {
          "format": "int64",
          "minimum": 1,
          "type": "integer"
        },
        "note_id": {
          "pattern": "^[0-9a-fA-F-]{36}$",
          "type": "string"
        }
      },
      "required": [
        "note_id",
        "expected_revision"
      ],
      "title": "McpDeleteNoteInput",
      "type": "object"
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "note_id": {
          "type": "string"
        },
        "revision": {
          "format": "int64",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "note_id",
        "revision"
      ],
      "title": "McpNoteRevisionOutput",
      "type": "object"
    }
  }
]
