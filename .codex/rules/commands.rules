# リポジトリ固有の補助規則です。サンドボックスや利用者の承認を置き換えません。

prefix_rule(
    pattern = ["git", ["diff", "log", "show", "status"]],
    decision = "allow",
    justification = "Gitの変更内容と履歴を確認します。",
    match = ["git status --short", "git diff --check"],
    not_match = ["git push upstream main"],
)

# Git変更操作や任意のshellを包めるコマンドを一括で許可しません。
# 個別の実行可否は利用者の依頼と実行環境の承認規則で判断します。
prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "未コミット変更を失うため禁止します。必要な変更を個別のpatchで行います。",
    match = ["git reset --hard HEAD"],
)

prefix_rule(
    pattern = ["git", "clean"],
    decision = "forbidden",
    justification = "未追跡の利用者データを守るため禁止します。対象を確認して個別に処理します。",
    match = ["git clean -fd"],
)

prefix_rule(
    pattern = ["git", "checkout", "--"],
    decision = "forbidden",
    justification = "未コミット変更を失うため禁止します。必要な変更を個別のpatchで行います。",
)

prefix_rule(
    pattern = ["rm", ["-rf", "-fr"]],
    decision = "forbidden",
    justification = "再帰的な強制削除を禁止します。対象を確認して個別に処理します。",
)
